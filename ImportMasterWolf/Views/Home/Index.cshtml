@model ImportMasterWolf.Models.Common.Class
@using ImportMasterWolf.Models.Common;
@{
    ViewData["Title"] = "Home | Thai Stanley";
    Layout = "~/Views/Shared/_MenuBar.cshtml";
}

@{
    string _Permission = User.Claims.FirstOrDefault(s => s.Type == "Permission").Value;
    string _NickName = User.Claims.FirstOrDefault(s => s.Type == "NICKNAME")?.Value;
    string _Name = User.Claims.FirstOrDefault(s => s.Type == "Name")?.Value;
    string _SurName = User.Claims.FirstOrDefault(s => s.Type == "SurName")?.Value;
    string _Division = User.Claims.FirstOrDefault(s => s.Type == "Division")?.Value;
    string _Section = User.Claims.FirstOrDefault(s => s.Type == "Section")?.Value;

}


<script src="~/js/Shared/_MenuBar.js"></script>
<link href="~/css/Home/siteHome.css" rel="stylesheet" />
<link href="~/css/cssTable.css" rel="stylesheet" />
<script type="text/javascript">document.onreadystatechange = () => { if (document.readyState === "interactive") { PositionY("Home"); } }</script>
<div class="home-content">
    <div id="DisplayContent" class="content-box">
        <div class="white-space"></div>
        <div class="container content-text">
            <div class="title-box">
                <div class="title">
                    <h2>ยินดีต้อนรับ</h2>

                </div>
            </div>
            <div class="content">
                <div>

                    @if (_Permission.ToUpper() == GlobalVariable.perAdmin.ToUpper())
                    {
                        <button class="btn btnOrange" onclick="GoNewRequest('Div')">Master Organizational</button>
                        <button class="btn btn-success" onclick="GoNewRequest('Accemployee')">Master Employee</button>

                    }

                    <button class="btn btn-success" onclick="GoNewRequest('OpenBlock')">Master Open Block</button>
                </div>

                @*
                    MSTATACCEmployee,MSTATEmployee,MSTEmployee
                    <input type="text" class="input-with-image datepicker  form-control center" style="width:20%;font-size:12px;" autocomplete="off">*@

            </div>
        </div>
    </div>
</div>

